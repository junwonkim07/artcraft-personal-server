# Names only. Do NOT fill this file in. Create the real .env with: scripts/generate-secrets.sh
# (random values, chmod 600, gitignored). Never commit .env.

# Generated secrets (leave empty here)
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
REDIS_PASSWORD=
COOKIE_SECRET=
SORT_KEY_SECRET=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Host ports. Always bound to 127.0.0.1 by docker-compose.yml; change only to avoid conflicts.
API_PORT=12345
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
WEBAPP_PORT=4201

# Browser-facing webapp origin (via SSH tunnel). Used for media links and baked into the webapp build.
WEBAPP_ORIGIN=http://localhost:4201

# Build without the personal-server patches (pristine upstream; media links then point to upstream CDNs).
# APPLY_PATCHES=false

# Seed upstream system roles once when the roles table is empty (true/false).
AUTO_SEED_ROLES=true

# Optional. Unset = backups are never deleted automatically.
# BACKUP_RETENTION_DAYS=30
