@@ -2,6 +2,7 @@
 use domains::Domain;
 use domains::fakeyou::{FAKEYOU_CDN, FAKEYOU_DEV_CDN};
 use server_environment::ServerEnvironment;
+use std::sync::OnceLock;
 use url::Url;
 
 // NB: Storyteller media is served from the FakeYou CDN too.
@@ -11,12 +12,44 @@
 const FAKEYOU_DEVELOPMENT: Domain = FAKEYOU_DEV_CDN;
 const STORYTELLER_DEVELOPMENT: Domain = FAKEYOU_DEV_CDN;
 
+/// Optional media CDN base (scheme + host [+ port], no path), e.g. `http://localhost:4201`.
+/// Set at most once at startup from `MEDIA_CDN_BASE_URL` (see `startup/build_dependencies.rs`).
+/// When unset (the default), the hardcoded hosts below are used unchanged.
+static MEDIA_CDN_BASE_URL_OVERRIDE: OnceLock<(String, Url)> = OnceLock::new();
+
+/// Install the media CDN base override. Only an origin is accepted (no path, query or fragment),
+/// because callers replace the URL path with the bucket object path.
+pub fn set_media_cdn_base_url_override(base_url: &str) -> anyhow::Result<()> {
+  let url = Url::parse(base_url.trim())?;
+  if url.scheme() != "http" && url.scheme() != "https" {
+    anyhow::bail!("MEDIA_CDN_BASE_URL must use http or https: {base_url}");
+  }
+  if url.host_str().is_none() || url.path() != "/" || url.query().is_some() || url.fragment().is_some() {
+    anyhow::bail!("MEDIA_CDN_BASE_URL must be an origin without path, e.g. http://localhost:4201 (got {base_url})");
+  }
+  let origin = url.origin().ascii_serialization(); // no trailing slash, like `https_link_without_path()`
+  let origin_url = Url::parse(&origin)?; // path "/", like `https_url()`
+  MEDIA_CDN_BASE_URL_OVERRIDE.set((origin, origin_url))
+      .map_err(|_| anyhow::anyhow!("MEDIA_CDN_BASE_URL override already set"))
+}
+
+/// The installed override, if any.
+pub fn media_cdn_base_url_override() -> Option<&'static str> {
+  MEDIA_CDN_BASE_URL_OVERRIDE.get().map(|(origin, _)| origin.as_str())
+}
+
 // TODO(bt,2025-01-31): Perhaps this should be config driven and configurable at runtime instead of hardcoded.
 pub fn get_cdn_host(media_domain: MediaDomain, server_environment: ServerEnvironment) -> &'static str {
+  if let Some(origin) = media_cdn_base_url_override() {
+    return origin;
+  }
   cdn_domain(media_domain, server_environment).https_link_without_path()
 }
 
 pub fn new_cdn_url(media_domain: MediaDomain, server_environment: ServerEnvironment) -> Url {
+  if let Some((_, url)) = MEDIA_CDN_BASE_URL_OVERRIDE.get() {
+    return url.clone();
+  }
   cdn_domain(media_domain, server_environment).https_url().clone()
 }
 
