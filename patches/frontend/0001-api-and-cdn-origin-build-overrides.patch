@@ -2,7 +2,21 @@
 const DEFAULT_API_HOST_PRODUCTION = "https://api.storyteller.ai";
 const DEFAULT_API_HOST_DEVELOPMENT = "http://localhost:12345";
 
+// Personal-server patch: optional build-time override of the production API host.
+// VITE_API_ORIGIN unset/empty -> upstream default above. "same-origin" -> window.location.origin
+// (for a reverse proxy serving the web app and /v1 on one origin). Otherwise an origin URL.
+function productionApiHost(): string {
+  const override = (import.meta.env.VITE_API_ORIGIN as string | undefined)?.trim();
+  if (!override) {
+    return DEFAULT_API_HOST_PRODUCTION;
+  }
+  if (override === "same-origin") {
+    return window.location.origin;
+  }
+  return override.replace(/\/+$/, "");
+}
 
