# Names only. Do NOT put real keys in this tracked example file. scripts/generate-secrets.sh creates the
# real, gitignored config/providers.env with these names and EMPTY values; fill in only what you need.
#
# Upstream storyteller-web requires every variable below to be PRESENT at boot
# (easyenv::get_env_string_required only checks presence, empty strings pass:
# crates/lib/easyenv/src/types/string.rs:30-37 @ d950e573). Empty = feature disabled.
# Paths below are relative to crates/service/web/storyteller_web/src.

# Email (Resend): startup/build_dependencies.rs:197
RESEND_API_KEY=

# Generation providers: startup/setup_inference_providers.rs:67-93
# Webhook URLs must be reachable from the provider, i.e. public. This starter exposes nothing publicly.
FAL_API_KEY=
FAL_WEBHOOK_URL=
GMICLOUD_API_KEY=
GROK_API_KEY=
BEEBLE_API_KEY=
BEEBLE_WEBHOOK_URL=
SEEDANCE2PRO_COOKIES=
SEEDANCE2PRO_WHITELIST_COOKIES=
SEEDANCE2PRO_BYTEPLUS_ULTRA_COOKIES=
OPENAI_API_KEY=
WORLDLABS_API_KEY=

# Stripe (billing): startup/setup_stripe_fakeyou.rs:17-34, startup/setup_stripe_artcraft.rs:8-10
# (STRIPE_PUBLISHABLE_KEY is optional upstream: setup_stripe_fakeyou.rs:20)
STRIPE_PORTAL_DEFAULT_CONFIG_ID=
STRIPE_SECRET_KEY=
STRIPE_SECRET_WEBHOOK_SIGNING_KEY=
STRIPE_FAKEYOU_ACCOUNT_ID=
STRIPE_ARTCRAFT_ACCOUNT_ID=
STRIPE_ARTCRAFT_SECRET_KEY=
STRIPE_ARTCRAFT_SECRET_WEBHOOK_KEY=
