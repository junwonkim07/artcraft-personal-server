# Non-secret storyteller-web settings for a local personal server.
# Every variable below is read by upstream code at d950e573; source is cited per line.
# Secrets (MYSQL_URL, REDIS_0_URL, COOKIE_SECRET, SORT_KEY_SECRET, ACCESS_KEY, SECRET_KEY)
# are injected by docker-compose.yml from .env. Third-party keys come from config/providers.env (gitignored).
# Paths are relative to crates/service/web/storyteller_web/src unless noted.

# startup/build_dependencies.rs:180 (required). "development" enables localhost CORS
# (crates/lib/actix_cors_configs/src/cors.rs tests: localhost allowed only in Development)
# and makes bootstrap load *.development*.env files if present (crates/lib/bootstrap/src/bootstrap.rs:118-150).
SERVER_ENVIRONMENT=development

# startup/build_dependencies.rs:99 (default 0.0.0.0:12345)
BIND_ADDRESS=0.0.0.0:12345
# startup/build_dependencies.rs:100 (default 8)
NUM_WORKERS=4
# configs/connect_to_database.rs:16-17
MYSQL_MAX_CONNECTIONS=10
MYSQL_MIN_CONNECTIONS=0

# Cookies: startup/build_dependencies.rs:101-106.
# The session cookie is host-only (the Domain attribute is commented out upstream:
# crates/lib/actix_artcraft/src/sessions/user_sessions/http_user_session_manager.rs:83), and a
# COOKIE_DOMAIN containing "localhost" makes it non-Secure + SameSite=Lax (same file :69-75),
# which is what http://localhost (SSH tunnel) needs. Runtime-unverified in a browser.
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
WEBSITE_HOMEPAGE_REDIRECT=http://localhost:4201

# Object storage (MinIO). startup/build_dependencies.rs:54-60,116-126.
# Non-GCS endpoints use path-style requests: crates/api_clients/cloud_storage/src/legacy_bucket_client.rs:76-82
S3_COMPATIBLE_ENDPOINT_URL=http://minio:9000
REGION_NAME=us-east-1
W2L_PRIVATE_DOWNLOAD_BUCKET_NAME=artcraft-private
W2L_PUBLIC_DOWNLOAD_BUCKET_NAME=artcraft-public
GC_ENABLED_PUBLIC_BUCKET_NAME=artcraft-public-gc
# Template-chosen prefix (any path works; not copied from upstream).
AUDIO_UPLOADS_BUCKET_ROOT=/audio_uploads

# Paging/metrics off (startup/setup_metrics.rs: metrics off unless ENABLE_METRICS=true)
ENABLE_PAGING=false
ENABLE_PAGING_FOR_500S=false
ENABLE_METRICS=false

# ---------------------------------------------------------------------------
# Non-secret Stripe redirect settings. upstream requires them to be present at boot
# (easyenv::get_env_string_required only checks presence: crates/lib/easyenv/src/types/string.rs:30-37).
# Billing itself does NOT work without Stripe keys (see config/providers.env, gitignored).
# ---------------------------------------------------------------------------
# startup/setup_stripe_fakeyou.rs:12-16. Template-chosen placeholder paths (billing is not supported here).
STRIPE_CHECKOUT_SUCCESS_URL_PATH=/billing/success
STRIPE_CHECKOUT_CANCEL_URL_PATH=/billing/cancel
STRIPE_PORTAL_RETURN_URL_PATH=/billing/return
# startup/setup_stripe_artcraft.rs:11-13. Template-chosen placeholders.
STRIPE_ARTCRAFT_CHECKOUT_SUCCESS_URL=http://localhost:4201/billing/success
STRIPE_ARTCRAFT_CHECKOUT_CANCEL_URL=http://localhost:4201/billing/cancel
STRIPE_ARTCRAFT_PORTAL_RETURN_URL=http://localhost:4201/billing/return

# Provider / Stripe / Resend keys are NOT in this tracked file.
# They live in config/providers.env (gitignored, created by scripts/generate-secrets.sh,
# names listed in config/providers.env.example).
